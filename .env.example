NODE_ENV=production
DATABASE_PATH=/data/santa.db
# openssl rand -hex 32. Set once, never rotate, back it up with .env: losing it loses the draw.
SANTA_DATA_KEY=
ADMIN_EMAIL=
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# The Access application's AUD tag.
CF_ACCESS_AUD=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# The @smtp-brevo.com login and an SMTP key, not account credentials.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Père Noël secret" <no-reply@axl-lvy.fr>
APP_URL=https://santa.axl-lvy.fr
# Development only. The app refuses to start with it in production.
DEV_IDENTITY_EMAIL=
